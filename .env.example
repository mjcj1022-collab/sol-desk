# Copy to .env and tweak. Every field in soldesk/config.py can be overridden as SOLDESK_<NAME>.
SOLDESK_MODE=mock            # mock | live-data   (both are PAPER money)
SOLDESK_STARTING_BALANCE=120
SOLDESK_TICK_SECONDS=15
SOLDESK_MIN_SCORE=70
SOLDESK_MAX_POSITION_PCT=8
SOLDESK_STOP_LOSS_PCT=6
SOLDESK_TRAIL_ACTIVATE_PCT=12
SOLDESK_TRAIL_DISTANCE_PCT=5
SOLDESK_SLIPPAGE_PCT=1.5
SOLDESK_FEE_PCT=0.3
SOLDESK_DAILY_LOSS_LIMIT_PCT=20

# Telegram alerts (optional) — see soldesk/notify.py for 2-minute setup
SOLDESK_TG_TOKEN=
SOLDESK_TG_CHAT=
# SOLDESK_TG_EVENTS=ENTER,WIN,LOSS,SKIP,ERROR
